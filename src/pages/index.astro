---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMotion from '../components/HeroMotion.jsx';
import PrinciplesCarousel from '../components/PrinciplesCarousel.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StackShowcase from '../components/StackShowcase.astro';
import Statement from '../components/Statement.astro';

const timeline = [
  ['2026', 'KONEKTADO', 'Research prototype · KONEKTADO AI adaptation', 'A community job-matching platform built first as an academic research system, then reframed as a focused AI-assisted hackathon concept.'],
  ['2025', 'FlowPress', 'Built and deployed at CJNET', 'The QR upload and print path for the shop, revised after watching how it was actually used.'],
  ['2024', 'Homelab', 'Self-hosted infrastructure', 'Linux, Docker, Nginx and Cloudflare routing. Where deployment became something I operate.'],
  ['2023', 'Polytechnic University of the Philippines', 'BSIT · final year', 'Coursework in systems, networks and databases, strengthened through projects built beyond the classroom.'],
  ['2021', 'CJNET Computer Shop', 'Family business · operations', 'Support, networking, print workflow and internal tools—and the environment that tells me which problems are worth building for.'],
  ['Next', 'Avera', 'Future direction', 'A product studio focused on practical software for workflows and communities I understand firsthand.']
];

const process = [
  ['01','Observe','Standing at the counter watching where the queue actually breaks—not asking anyone what they need.'],
  ['02','Define','The workflow gets written before the stack does. Most ideas die here, which is the cheapest place to die.'],
  ['03','Build & deploy','AI agents help with implementation. I own the requirements, architecture, integration, validation and the environment the system runs on.'],
  ['04','Watch & revise','Real use is the test. I watch where people work around the system, then rebuild around what they actually do.']
];

const questions = [
  ['design and build?', 'Can you design and build it?', 'Yes—the same person decides what it should do, designs it, writes it, and puts it on the server. Nothing gets lost in a handoff because there isn’t one.'],
  ['shipped anything real?', 'Have you shipped anything real?', 'FlowPress runs at our family shop every day, and I have two client projects in progress right now. Not demos, not coursework.'],
  ['what have you gotten wrong?', 'What have you gotten wrong?', 'Plenty. The admin queue I built for FlowPress was bypassed by the staff it was for. I still lack a lot—I treat that as the job, not an admission. Eternal student.'],
  ['do you actually use AI to code?', 'Do you actually use AI to code?', 'Yes, as an implementation partner. I carry a heavy load between school, the shop and client work, so agents do typing I would otherwise do slowly. Requirements, architecture, debugging and deployment stay mine.'],
  ['what are you looking for?', 'What are you looking for?', 'I’m looking for an internship or an opportunity with a small, hands-on team where I can take ownership of real problems from start to finish. I want to understand user needs, help decide what should be built, contribute to the development, ship the solution, and learn from how it performs in actual use.']
];
---

<BaseLayout>
  <HeroMotion client:load />

  <div class="marquee" aria-hidden="true"><div>{[0,1].map(() => <span>Product engineering <i>✳</i> Full stack <i>✳</i> Internal tools <i>✳</i> Self-hosted infrastructure <i>✳</i> Deployment <i>✳</i> Watching real users <i>✳</i></span>)}</div></div>

  <Statement />

  <ProjectShowcase />

  <section class="timeline" data-screen-label="Timeline">
    <SectionHeading number="03" title="Path" note="2021 — present" />
    <div class="timeline-grid"><i class="timeline-spine"><b></b></i>{timeline.map(([year,title,meta,copy]) => <article data-reveal data-erow><i data-erow-wipe></i><strong>{year}</strong><div><h3 data-erow-title>{title}</h3><span>{meta}</span><p data-erow-detail>{copy}</p></div></article>)}</div>
  </section>

  <StackShowcase />

  <section class="process" data-screen-label="How I work">
    <SectionHeading number="05" title="How I work" note="Four steps, one feedback loop" />
    <div class="process-grid" data-steps>{process.map(([number,title,copy]) => <article data-step><i><b data-step-fill></b></i><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
    <p class="process-manifesto" data-reveal>The judgement is the job. The typing is not.</p>
  </section>

  <PrinciplesCarousel />

  <button data-ask-toggle type="button" tabindex="-1" aria-expanded="false" aria-controls="ask-overlay" aria-label="Ask me something" style="position:fixed;right:clamp(16px,2.4vw,30px);bottom:clamp(16px,2.4vw,30px);z-index:94;opacity:0;pointer-events:none;transform:translateY(10px);appearance:none;cursor:pointer;display:flex;align-items:center;gap:11px;padding:13px 17px;border:1px solid var(--line);background:var(--surface);color:var(--fg-62);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;transition:opacity .8s ease,transform .9s cubic-bezier(.16,1,.3,1),color .35s ease,border-color .35s ease,background .35s ease">
    <span data-ask-dot style="display:block;width:7px;height:7px;border-radius:50%;background:var(--accent);transition:transform .45s cubic-bezier(.16,1,.3,1)"></span>
    <span data-ask-label>Ask</span>
  </button>

  <div id="ask-overlay" data-ask-overlay role="dialog" aria-modal="true" aria-label="Ask me something" aria-hidden="true" inert style="position:fixed;inset:0;z-index:93;opacity:0;pointer-events:none;transition:opacity .2s ease .72s">
    <div data-ask-wash aria-hidden="true" style="position:absolute;inset:0;background:var(--accent);clip-path:circle(0 at 100% 100%);transition:clip-path .62s cubic-bezier(.76,0,.24,1),opacity .38s ease"></div>
    <div data-ask-surface aria-hidden="true" style="position:absolute;inset:0;background:var(--ov);backdrop-filter:blur(26px) saturate(1.35);-webkit-backdrop-filter:blur(26px) saturate(1.35);clip-path:circle(0 at 100% 100%);transition:clip-path .72s cubic-bezier(.76,0,.24,1)"></div>
    <div data-ask-stage style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;justify-content:center;padding:clamp(70px,10vh,140px) clamp(24px,7vw,120px) clamp(90px,12vh,150px);overflow-y:auto;opacity:0;transform:translateY(12px);transition:opacity .4s ease,transform .6s cubic-bezier(.16,1,.3,1)">
      <div style="display:grid;grid-template-columns:1fr">
        <div data-ask-list style="grid-area:1/1;transition:opacity .4s ease,transform .6s cubic-bezier(.16,1,.3,1)">
          <div data-ask-line style="font-family:'JetBrains Mono',monospace;font-size:clamp(22px,3.3vw,44px);letter-spacing:.01em;color:var(--fg);margin-bottom:clamp(34px,5vh,62px);text-wrap:balance;opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .8s cubic-bezier(.16,1,.3,1)">what do you want to ask?</div>
          <div style="display:flex;flex-direction:column;align-items:flex-start">
            {questions.map(([label], index) => <button data-ask-question={index} data-ask-line type="button" style="opacity:0;transform:translateY(14px);appearance:none;border:0;background:transparent;cursor:pointer;text-align:left;display:flex;align-items:baseline;gap:14px;padding:7px 0;font-family:'JetBrains Mono',monospace;font-size:clamp(13px,1.35vw,17px);letter-spacing:.03em;color:var(--fg-50);transition:opacity .5s ease,color .3s ease,transform .55s cubic-bezier(.16,1,.3,1)"><span data-ask-mark aria-hidden="true" style="color:var(--accent);opacity:0;transition:opacity .3s ease">→</span><span>{label}</span></button>)}
          </div>
        </div>
        {questions.map(([label,,answer], index) => <div data-ask-answer={index} style="grid-area:1/1;opacity:0;transform:translateY(16px);pointer-events:none;transition:opacity .5s ease,transform .7s cubic-bezier(.16,1,.3,1)"><div style="font-family:'JetBrains Mono',monospace;font-size:clamp(12px,1.15vw,14px);letter-spacing:.06em;color:var(--accent);margin-bottom:clamp(20px,3vh,30px)">{label}</div><p style="margin:0;max-width:22em;font-size:clamp(22px,2.9vw,44px);font-weight:500;letter-spacing:-.03em;line-height:1.22;text-wrap:pretty">{answer}</p></div>)}
      </div>
      <button data-ask-back type="button" tabindex="-1" style="align-self:flex-start;margin-top:clamp(34px,5vh,58px);opacity:0;pointer-events:none;appearance:none;border:0;background:transparent;cursor:pointer;padding:0;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--fg-50);transition:opacity .4s ease,color .3s ease">← All questions</button>
    </div>
  </div>

  <footer class="contact" id="contact" data-screen-label="Contact">
    <SectionHeading number="07" title="Contact" />
    <a class="contact-title" href="mailto:jamescarlorivera52@gmail.com">Let’s build<br />something↗</a>
    <div class="contact-meta"><div><span>Where</span><strong>Batangas, Philippines</strong></div><div><span>Open to</span><strong>Internships · product engineering</strong></div><div><span>Reach me</span><a href="mailto:jamescarlorivera52@gmail.com">Email ↗</a><a href="https://github.com/James-Rivera" target="_blank" rel="noreferrer">GitHub ↗</a></div></div>
    <div class="contact-bottom"><span>© {new Date().getFullYear()} James Carlo Rivera</span><span data-clock>Asia/Manila</span><a href="#top">Back to top ↑</a></div>
  </footer>
</BaseLayout>
