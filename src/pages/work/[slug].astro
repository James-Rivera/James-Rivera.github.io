---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects.js';
import { getCaseDetail } from '../../data/cases.js';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const detail = getCaseDetail(project);
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
---

<BaseLayout title={`${project.title} — James Carlo Rivera`} description={detail.summary || project.summary} image={project.image} rail={false}>
  <article class="case-study" style={`--project-accent:${project.accent}`}>
    <nav class="case-nav" aria-label="Case study navigation">
      <a href="/#work">← All work</a>
      <a class="mono-brand" href="/"><i>◒</i> James Carlo Rivera</a>
      <button class="theme-toggle" type="button" aria-label="Switch color theme"><span></span><b data-theme-label>Dark</b></button>
    </nav>

    <header class="case-hero">
      <p class="case-eyebrow">({project.number}) — {detail.eyebrow}</p>
      <h1>{project.title}</h1>
      <p class="case-summary">{detail.summary || project.summary}</p>
      <div class="case-fact-row">
        {detail.facts.map(([label,value]: [string,string]) => <div><strong>{value}</strong><span>{label}</span></div>)}
      </div>
    </header>

    <div class="case-cover" aria-hidden="true">
      {project.image ? <img src={project.image} alt="" /> : <div class="case-cover-art"><span>{project.number}</span><strong>{project.title}</strong><i></i><i></i><i></i></div>}
      <p>{project.title} — project cover</p>
    </div>

    <div class="case-sections">
      {detail.sections.map((section: { title: string; lead?: string; body?: string; items?: [string,string][] },index: number) => <section data-reveal>
        <header><p>({String(index + 2).padStart(2,'0')}) — {section.title}</p></header>
        {section.lead && <h2>{section.lead}</h2>}
        {section.body && <p class="case-body-copy">{section.body}</p>}
        {section.items && <div class="case-item-grid">{section.items.map(([title,copy]: [string,string]) => <article><strong>{title}</strong><p>{copy}</p></article>)}</div>}
      </section>)}
    </div>

    <footer class="case-footer">
      <div><a href="/#work">← Back to all work</a><span>{project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noreferrer">Live project ↗</a>}{project.repoUrl && <a href={project.repoUrl} target="_blank" rel="noreferrer">GitHub ↗</a>}</span></div>
      <a class="case-next" href={`/work/${nextProject.slug}/`}><span>Next project</span><strong>{nextProject.title}</strong><i>↗</i></a>
    </footer>
  </article>
</BaseLayout>
