---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkIndex from '../../components/WorkIndex.jsx';
import SiteNav from '../../components/SiteNav.astro';
import { projects } from '../../data/projects.js';
import '../../styles/work-index.css';

const workProjects = projects.map((project, index) => {
  const external = project.slug === 'solesource' || project.kind === 'school';
  return {
    slug: project.slug,
    number: String(index + 1).padStart(2, '0'),
    title: project.slug === 'cjnet' ? 'CJNET Operations' : project.title,
    label: project.slug === 'konektado' ? 'Community platform' : project.label,
    year: project.kind === 'school' ? (index < 7 ? '2024' : '2023') : project.year,
    group: project.kind === 'school' ? 'school' : 'systems',
    href: external ? project.liveUrl : `/work/${project.slug}/`,
    external,
    cover: project.image || null,
    imageAlt: project.imageAlt || ''
  };
});
---
<BaseLayout title="Selected works — James Carlo Rivera" description="Index of every project by James Carlo Rivera: operational systems, internal tools, self-hosted infrastructure and school work." rail={false}>
  <div class="work-page">
    <SiteNav current="work" />
    <header class="work-header" id="work" data-screen-label="Work index"><p>Work archive</p><h1>Selected works</h1></header>
    <WorkIndex projects={workProjects} client:load />
  </div>
</BaseLayout>
