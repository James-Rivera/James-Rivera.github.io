---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkIndex from '../../components/WorkIndex.jsx';
import SiteNav from '../../components/SiteNav.astro';
import { projects } from '../../data/projects.js';
import '../../styles/work-index.css';

const workProjects = projects.map((project, index) => {
  return {
    slug: project.slug,
    number: String(index + 1).padStart(2, '0'),
    title: project.slug === 'cjnet' ? 'CJNET Operations' : project.title,
    label: project.slug === 'konektado' ? 'Community platform' : project.label,
    year: project.year,
    group: project.kind === 'featured' ? 'systems' : 'school',
    href: `/work/${project.slug}/`,
    external: false,
    cover: project.image || null,
    imageAlt: project.imageAlt || '',
    accent: project.accent || '#1f5fef'
  };
});
---
<BaseLayout title="Selected works — James Carlo Rivera" description="Web and mobile development by James Carlo Rivera: KONEKTADO, SoleSource, PhotoDesk, FlowPress, Avera Homelab and an archive of earlier work." rail={false}>
  <div class="work-page">
    <SiteNav current="work" />
    <header class="work-header" id="work" data-screen-label="Work index"><p>Work archive</p><h1>Selected works</h1></header>
    <WorkIndex projects={workProjects} client:load />
  </div>
</BaseLayout>
