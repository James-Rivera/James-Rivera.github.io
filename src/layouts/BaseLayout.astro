---
import '../styles/global.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  rail?: boolean;
}

const {
  title = 'James Carlo Rivera — Product Engineer & Systems Builder',
  description = 'Product engineer in Batangas building complete systems for real operational problems.',
  image = '/images/Logo.svg',
  rail = true
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const socialImage = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0D12" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('portfolio-theme');
        document.documentElement.classList.add('js');
        document.documentElement.dataset.theme = saved || 'dark';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>
    {rail && <aside class="section-rail" data-rail aria-hidden="true">
      <button class="theme-toggle" type="button" aria-label="Switch color theme">
        <span></span><b data-theme-label>Dark</b>
      </button>
      <span data-rail-label>Hero</span>
      <i><em data-rail-fill></em></i>
    </aside>}
    <main id="main-content"><slot /></main>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
