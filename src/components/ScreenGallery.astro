---
const { screens = [], project } = Astro.props;
---

<div class="screen-gallery">
  {screens.map(([label, format]: [string, string], index: number) => (
    <figure data-tile>
      <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{project}</strong><i></i><i></i></div>
      <figcaption><strong>{label}</strong><span>{format}</span></figcaption>
    </figure>
  ))}
</div>
