---
import HoverSwap from './HoverSwap.astro';
import SectionHeading from './SectionHeading.astro';
import '../styles/showcases.css';
---

<section class="principles principles-carousel" data-screen-label="Principles" data-principles-carousel>
  <SectionHeading number="06" title="Principles" note="Cycles while in view" />

  <div class="principle-copy" aria-live="polite">
    <blockquote class="is-active" id="principle-useful" data-principle-card>
      <small>On staying useful</small>
      <strong data-principle-text>I don’t chase <HoverSwap word="frameworks" alternate="npm i whatever@latest — no thanks" />. I learn principles.</strong>
    </blockquote>
    <blockquote id="principle-people" data-principle-card aria-hidden="true">
      <small>On what the job is</small>
      <strong data-principle-text>Great software isn’t written into existence. It comes from understanding <HoverSwap word="people" alternate="walk-ins, not personas" />&nbsp;and designing systems that survive being used.</strong>
    </blockquote>
    <blockquote id="principle-learning" data-principle-card aria-hidden="true">
      <small>On why there is always another one</small>
      <strong data-principle-text>Every project has to teach me something I didn’t know <HoverSwap word="yesterday" alternate="git log --since=yesterday" />.</strong>
    </blockquote>
  </div>

  <div class="principle-controls">
    <div class="principle-tabs" role="tablist" aria-label="Principles">
      <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls="principle-useful" data-principle-tab="0"><span class="visually-hidden">On staying useful</span></button>
      <button type="button" role="tab" aria-selected="false" aria-controls="principle-people" tabindex="-1" data-principle-tab="1"><span class="visually-hidden">On what the job is</span></button>
      <button type="button" role="tab" aria-selected="false" aria-controls="principle-learning" tabindex="-1" data-principle-tab="2"><span class="visually-hidden">On continuous learning</span></button>
    </div>
    <div class="principle-actions">
      <output data-principle-count>01 / 03</output>
      <button class="principle-next" type="button" data-principle-next>Next principle <span aria-hidden="true">→</span></button>
    </div>
  </div>
</section>

<script>
  import { initPrincipleCarousels } from '../scripts/showcases.js';
  initPrincipleCarousels();
</script>
