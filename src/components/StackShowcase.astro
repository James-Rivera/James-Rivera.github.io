---
import SectionHeading from './SectionHeading.astro';
import '../styles/showcases.css';

interface StackGroup {
  id: string;
  label: string;
  title: string;
  note: string;
  areas: Array<[string, string[]]>;
}

const groups: StackGroup[] = [
  { id: 'proven', label: 'Project experience', title: 'Used in application development and operations', note: 'Hands-on experience across projects; depth varies by technology.', areas: [
    ['Programming & Web', ['JavaScript','TypeScript','PHP','SQL','HTML','CSS']],
    ['Frameworks & Development', ['React','Next.js','React Native','Expo','Bootstrap']],
    ['Backend & Databases', ['MySQL','Supabase','PostgreSQL','REST APIs']],
    ['Infrastructure', ['Ubuntu Linux','Docker','MikroTik RouterOS','WinBox','Networking','Windows']],
    ['Development Tools', ['Git','GitHub','Figma']]
  ] },
  { id: 'working', label: 'Academic foundation', title: 'Formal BSIT coursework', note: 'Completed university subjects, reinforced through practical projects.', areas: [
    ['Computer Science Foundations', ['Object-Oriented Programming','Computer Programming','Structured Programming','Data Structures and Algorithms','Database Management']],
    ['Applied Practice', ['Database Integration','API Integration','Debugging','Testing']]
  ] },
  { id: 'exploring', label: 'Learning', title: 'Basic exposure and continued study', note: 'Areas I am still developing; not presented as production expertise.', areas: [
    ['Software Systems', ['Node.js','System design','Security fundamentals']],
    ['Research & Exploration', ['Semantic retrieval','Embeddings','STM32','Embedded systems']]
  ] }
];
---

<section class="stack" id="skills" data-screen-label="Technical skills">
  <SectionHeading number="05" title="Technical skills" note="Project experience, coursework & learning" />

  <div class="section-switcher" data-segmented>
    <div class="section-switcher-tabs" role="tablist" aria-label="Technology experience levels">
      {groups.map(({ id, label }, index) => (
        <button class:list={[index === 0 && 'is-active']} id={`stack-${id}-tab`} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`stack-${id}`} tabindex={index === 0 ? undefined : '-1'} data-segmented-tab={id}>{label}</button>
      ))}
    </div>

    <div class="section-switcher-panels section-switcher-panels--stack">
      {groups.map(({ id, title, note, areas }, index) => (
        <div class:list={['section-switcher-panel', index === 0 && 'is-active']} id={`stack-${id}`} role="tabpanel" aria-labelledby={`stack-${id}-tab`} aria-hidden={index === 0 ? undefined : 'true'} inert={index !== 0} data-segmented-panel={id}>
          <div class="stack-group">
            <header><strong>{title}</strong><span>{note}</span></header>
            <div class="stack-areas">{areas.map(([area, items]) => (
              <section class="stack-area">
                <h3>{area}</h3>
                <div>{items.map((item) => <span>{item}</span>)}</div>
              </section>
            ))}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { initSegmentedControls } from '../scripts/showcases.js';
  initSegmentedControls();
</script>
