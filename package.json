  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "typescript": "5.9.3",
    "wrangler": "^4.118.0"
  }
}
