{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "james-rivera-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    {
      "pattern": "jamesrivera.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.jamesrivera.dev",
      "custom_domain": true
    }
  ],

  // Astro generates the production website into this directory.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // API logs will be visible in the Cloudflare dashboard after deployment.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
